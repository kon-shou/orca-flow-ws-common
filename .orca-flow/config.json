{
  "baseBranch": "main",
  "idPrefix": "C",
  "branchPrefix": "task/",
  "tasksDir": "docs/tasks",
  "reportsDir": "docs/tasks/reports",
  "progress": null,
  "readFirst": [
    "CLAUDE.md"
  ],
  "verify": [
    "npm test"
  ],
  "pathVerify": [],
  "verifySkipPaths": [],
  "sharedPaths": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "package-lock.json",
    "yarn.lock",
    "bun.lock",
    "bun.lockb",
    "pyproject.toml",
    "uv.lock",
    "Cargo.toml",
    "Cargo.lock",
    "go.mod",
    "go.sum",
    "composer.json",
    "composer.lock",
    "CLAUDE.md",
    ".claude/",
    ".orca-flow/",
    "orca.yaml",
    ".gitattributes",
    ".worktreeinclude"
  ],
  "appendOnlyFiles": [],
  "maxActiveTasks": 3,
  "maxWorkersPerTask": 3,
  "lead": {
    "agent": "claude",
    "model": "claude-opus-5-5",
    "effort": "high"
  },
  "workerAgent": "orca-flow:task-worker",
  "reviewerAgent": "orca-flow:task-reviewer",
  "codeReview": "full",
  "reviewBackend": "claude",
  "localReview": {
    "baseUrl": "http://localhost:8080",
    "model": "glm-5.3-flash",
    "runner": "claude",
    "stageLimits": [
      5,
      3
    ],
    "fullReviewAt": [
      1,
      3,
      5
    ],
    "stopOnNoMustFix": true,
    "repeatLimit": 2,
    "maxMinutes": 120,
    "maxFixLines": 300,
    "opusChecks": 2,
    "fallback": "claude-once",
    "contextLedger": true,
    "requireNewEvidence": true,
    "revertGuard": true,
    "humanReviewCategories": [
      "security",
      "auth",
      "data-loss",
      "migration"
    ]
  },
  "integratorName": "統括役",
  "taskEnd": "pr",
  "prReady": "after-ci"
}
